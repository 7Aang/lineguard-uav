<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="lineguard_powerline">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>
    <wind>
      <linear_velocity>8 1 0</linear_velocity>
    </wind>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 300</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 300</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.25 0.12 1</ambient>
            <diffuse>0.28 0.38 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tower_3">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="structure">
        <visual name="mast">
          <pose>0 0 16 0 0 0</pose>
          <geometry><box><size>1.8 1.8 32</size></box></geometry>
          <material>
            <ambient>0.35 0.37 0.40 1</ambient>
            <diffuse>0.55 0.57 0.60 1</diffuse>
          </material>
        </visual>
        <visual name="crossarm">
          <pose>0 0 25 0 0 0</pose>
          <geometry><box><size>1.2 18 0.8</size></box></geometry>
          <material><diffuse>0.55 0.57 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tower_4">
      <static>true</static>
      <pose>50 0 0 0 0 0</pose>
      <link name="structure">
        <visual name="mast">
          <pose>0 0 16 0 0 0</pose>
          <geometry><box><size>1.8 1.8 32</size></box></geometry>
          <material><diffuse>0.55 0.57 0.60 1</diffuse></material>
        </visual>
        <visual name="crossarm">
          <pose>0 0 25 0 0 0</pose>
          <geometry><box><size>1.2 18 0.8</size></box></geometry>
          <material><diffuse>0.55 0.57 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tower_5">
      <static>true</static>
      <pose>100 0 0 0 0 0</pose>
      <link name="structure">
        <visual name="mast">
          <pose>0 0 16 0 0 0</pose>
          <geometry><box><size>1.8 1.8 32</size></box></geometry>
          <material><diffuse>0.55 0.57 0.60 1</diffuse></material>
        </visual>
        <visual name="crossarm">
          <pose>0 0 25 0 0 0</pose>
          <geometry><box><size>1.2 18 0.8</size></box></geometry>
          <material><diffuse>0.55 0.57 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="conductors">
      <static>true</static>
      <link name="lines">
        <visual name="left_conductor">
          <pose>50 -6 24 0 1.570796 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>100</length></cylinder></geometry>
          <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <visual name="center_conductor">
          <pose>50 0 25 0 1.570796 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>100</length></cylinder></geometry>
          <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <visual name="right_conductor">
          <pose>50 6 24 0 1.570796 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>100</length></cylinder></geometry>
          <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <visual name="ground_wire">
          <pose>50 0 31 0 1.570796 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>100</length></cylinder></geometry>
          <material><diffuse>0.18 0.18 0.18 1</diffuse></material>
        </visual>
        <visual name="spacer_1">
          <pose>48 0 25 0 0 0</pose>
          <geometry><box><size>0.3 12 0.3</size></box></geometry>
          <material><diffuse>0.9 0.55 0.05 1</diffuse></material>
        </visual>
        <visual name="spacer_2">
